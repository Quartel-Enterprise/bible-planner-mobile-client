# Fastfile — CI/CD lanes for Bible Planner
# https://docs.fastlane.tools/
#
# These lanes are designed to run on GitHub Actions (see .github/workflows/release.yml).
# All credentials are provided through environment variables / GitHub secrets.
#
# fastlane runs lanes from the `fastlane/` directory, so every path below is
# resolved against the repository root, captured once per lane as `repo_root`.

opt_out_usage
skip_docs

require "json"

APP_BUNDLE_ID    = "com.quare.bibleplanner.BiblePlanner".freeze
WIDGET_BUNDLE_ID = "com.quare.bibleplanner.BiblePlanner.BibleDownloadWidget".freeze
ANDROID_PACKAGE  = "com.quare.bibleplanner".freeze
APPLE_TEAM_ID    = "TTV2A365LG".freeze
XCODE_PROJECT    = "iosApp/iosApp.xcodeproj".freeze
VERSION_XCCONFIG = "version.xcconfig".freeze
RELEASE_NOTES_DIR = "feature/release_notes/src/commonMain/composeResources/files/release_notes".freeze
PLAY_DATA_SAFETY_CSV = "fastlane/metadata/android/data_safety.csv".freeze

# Per-store character limits for release notes. Google Play hard-fails the
# upload when exceeded; App Store rejects the metadata at submit time.
PLAY_CHANGELOG_MAX_CHARS = 500
APP_STORE_RELEASE_NOTES_MAX_CHARS = 4000

# How often, and how far apart, the App Store screenshot upload is tried again when App Store
# Connect has not yet finished deleting the screenshot sets it replaces — see
# retrying_screenshot_set_race.
SCREENSHOT_SET_RACE_MESSAGE = "Screenshot Set Already Exists".freeze
SCREENSHOT_SET_RACE_ATTEMPTS = 3
SCREENSHOT_SET_RACE_WAIT_SECONDS = 30

# Appended on its own line when items had to be dropped to fit the limit.
TRUNCATION_SUFFIX = {
  "en" => "…and more",
  "pt" => "…e mais",
  "es" => "…y más",
}.freeze

# Each version in the release notes JSON groups its notes into platform buckets:
# every store gets the "common" notes plus the ones of its own platform.
RELEASE_NOTES_COMMON_BUCKET = "common".freeze

# Used when the version has notes, but none for the store's platform: the App
# Store refuses to submit a version for review without a "What's New".
GENERIC_RELEASE_NOTES = {
  "en" => "Bug fixes and performance improvements.",
  "pt" => "Correções de problemas e melhorias de desempenho.",
  "es" => "Corrección de errores y mejoras de rendimiento.",
}.freeze

# Reads the app version from version.xcconfig — the single source of truth every
# platform shares, see scripts/bump-version.sh — as [versionName, versionCode].
# Config.xcconfig only aliases it, so its MARKETING_VERSION/CURRENT_PROJECT_VERSION
# read back as literal `$(versionName)`/`$(versionCode)` and must not be used here.
def app_version(repo_root)
  props = File.read(File.join(repo_root, VERSION_XCCONFIG))
  version = props[/^versionName=(.+)$/, 1]&.strip
  version_code = props[/^versionCode=(.+)$/, 1]&.strip
  UI.user_error!("Could not read versionName/versionCode from #{VERSION_XCCONFIG}") if version.nil? || version_code.nil?

  [version, version_code]
end

# Reads the in-app release notes JSON files and returns the notes the given
# platform ("android", "ios" or "desktop") shows for the version, as
# { "en" => [items], "pt" => [items], "es" => [items] }: the "common" bucket
# followed by the platform's own. A version whose notes all target other
# platforms gets GENERIC_RELEASE_NOTES; a version absent from a file is left out.
# The JSON files are keyed by plain X.Y.Z, so a pre-release versionName such as
# 2.4.0-beta-1 is normalized to its X.Y.Z prefix before the lookup.
def release_notes_for_version(version, platform, repo_root)
  version = version[/\A\d+\.\d+\.\d+/] || version
  notes = {}
  { "en" => "en.json", "pt" => "pt.json", "es" => "es.json" }.each do |lang, file|
    path = File.join(repo_root, RELEASE_NOTES_DIR, file)
    next unless File.exist?(path)

    buckets = JSON.parse(File.read(path))[version]
    next unless buckets.is_a?(Hash) && !buckets.empty?

    items = Array(buckets[RELEASE_NOTES_COMMON_BUCKET]) + Array(buckets[platform])
    notes[lang] = items.empty? ? [GENERIC_RELEASE_NOTES[lang]] : items
  end
  notes
end

# Joins release-note items with newlines so the result fits within `max`
# characters. Drops trailing items when necessary and appends a localized
# "…and more" line. Falls back to hard-truncating the first item when even
# it plus the suffix overruns the limit.
def fit_release_notes(items, lang, max)
  text = items.join("\n")
  return text if text.length <= max

  suffix = TRUNCATION_SUFFIX[lang] || TRUNCATION_SUFFIX["en"]
  kept = []
  items.each do |item|
    candidate = (kept + [item, suffix]).join("\n")
    break if candidate.length > max
    kept << item
  end

  if kept.empty?
    available = [max - suffix.length - 1, 0].max
    return [items.first.to_s[0, available].rstrip, suffix].join("\n")
  end

  (kept + [suffix]).join("\n")
end

# Lists the locales of the app's App Store listing (e.g. ["en-US", "pt-BR", "es-MX"]).
# Uses the global Spaceship session configured by app_store_connect_api_key
# (set_spaceship_token: true) — avoids re-parsing the .p8 key by hand.
def app_store_listing_locales
  require "spaceship"
  app = Spaceship::ConnectAPI::App.find(APP_BUNDLE_ID)
  version = app.get_live_app_store_version || app.get_edit_app_store_version
  version.get_app_store_version_localizations.map(&:locale)
end

# Writes <repo>/fastlane/metadata/<locale>/release_notes.txt for every App Store
# locale that has matching in-app release notes. Returns true if any file was
# written. "What's New" comes from the in-app release notes JSON, keyed by the
# version currently set in version.xcconfig.
def stage_release_notes(repo_root)
  version, = app_version(repo_root)
  notes = release_notes_for_version(version, "ios", repo_root)
  if notes.empty?
    UI.important("No in-app release notes found for #{version} — App Store 'What's New' will be left unchanged.")
    return false
  end

  written = false
  app_store_listing_locales.each do |locale|
    lang = locale.split("-").first.downcase
    items = notes[lang]
    next unless items

    text = fit_release_notes(items, lang, APP_STORE_RELEASE_NOTES_MAX_CHARS)
    dir = File.join(repo_root, "fastlane", "metadata", locale)
    FileUtils.mkdir_p(dir)
    File.write(File.join(dir, "release_notes.txt"), text)
    UI.message("Staged 'What's New' for #{locale}")
    written = true
  end
  written
end

# Writes <repo>/fastlane/metadata/android/<locale>/changelogs/<versionCode>.txt
# from the in-app release notes JSON. Returns true if any file was written.
def stage_play_changelogs(version, version_code, repo_root)
  notes = release_notes_for_version(version, "android", repo_root)
  return false if notes.empty?

  written = false
  # Play Store listing locales. Spanish notes are reused across every Spanish
  # variant the listing supports.
  { "en" => ["en-US"], "pt" => ["pt-BR"], "es" => ["es-419", "es-ES", "es-US"] }.each do |lang, locales|
    items = notes[lang]
    next unless items

    text = fit_release_notes(items, lang, PLAY_CHANGELOG_MAX_CHARS)
    locales.each do |locale|
      dir = File.join(repo_root, "fastlane", "metadata", "android", locale, "changelogs")
      FileUtils.mkdir_p(dir)
      File.write(File.join(dir, "#{version_code}.txt"), text)
      UI.message("Staged Play changelog for #{locale}")
      written = true
    end
  end
  written
end

# ---------------------------------------------------------------------------
# Android
# ---------------------------------------------------------------------------
platform :android do
  desc "Build the signed release AAB (no upload) — see the `upload` lane"
  lane :build do
    # Release signing is wired in androidApp/build.gradle.kts and reads the
    # ANDROID_KEYSTORE_* environment variables exported by the workflow.
    # The AAB is written to androidApp/build/outputs/bundle/release/ and the
    # workflow hands it to the `upload` lane (a separate job).
    gradle(
      task: ":androidApp:bundleRelease",
    )
  end

  desc "Upload an already-built AAB (from the `build` lane) to Google Play"
  desc "Options: track (production|beta|alpha|internal) — defaults to production"
  lane :upload do |options|
    # fastlane runs the lane from fastlane/; the repo root is its parent.
    repo_root = File.expand_path("..")
    track = options[:track] || "production"

    # Build the Play "What's new" from the in-app release notes JSON, keyed by
    # the version currently set in version.xcconfig. Non-fatal on failure.
    version, version_code = app_version(repo_root)
    has_changelogs = false
    begin
      has_changelogs = stage_play_changelogs(version, version_code, repo_root)
    rescue => e
      UI.error("Could not prepare Play changelogs, continuing without them: #{e.message}")
    end

    # "completed" rolls the release out to the track; "draft" uploads the
    # build without releasing it, to be released manually from the Play Console.
    release_status = ENV.fetch("COMPLETE_RELEASE", "true").strip.downcase == "true" ? "completed" : "draft"

    upload_to_play_store(
      package_name: ANDROID_PACKAGE,
      track: track,
      release_status: release_status,
      aab: File.join(repo_root, "androidApp/build/outputs/bundle/release/androidApp-release.aab"),
      metadata_path: File.join(repo_root, "fastlane/metadata/android"),
      json_key: ENV.fetch("PLAY_STORE_JSON_KEY_PATH"),
      # The listing copy — title, short and full description — is versioned under
      # fastlane/metadata/android/, so the repo is what the Play listing says. Edit it
      # there in a PR, never in the Play Console: the next release overwrites the console.
      skip_upload_metadata: false,
      skip_upload_changelogs: !has_changelogs,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end

  desc "Upload only the store listing screenshots to Google Play — no build, no release."
  desc "Regenerates them first, so what is uploaded always matches the current app."
  desc "Runs whenever: Play keeps the listing separate from the release, so this needs no version."
  desc "Options: skip_render (true|false) — upload what is already staged under"
  desc "fastlane/metadata/android/, which is how CI hands over the images a job of its own rendered."
  lane :upload_screenshots do |options|
    repo_root = File.expand_path("..")
    metadata_path = File.join(repo_root, "fastlane/metadata/android")

    gradle(task: "stagePlayStoreScreenshots", project_dir: repo_root) unless options[:skip_render]
    ensure_screenshots_staged(File.join(metadata_path, "*", "images", "*", "*.png"))

    upload_to_play_store(
      package_name: ANDROID_PACKAGE,
      json_key: ENV.fetch("PLAY_STORE_JSON_KEY_PATH"),
      metadata_path: metadata_path,
      # Listing assets only: no artifact, no track, nothing else about the listing.
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: false,
      validate_only: ENV.fetch("VALIDATE_ONLY", "false").strip.downcase == "true",
    )
  end

  desc "Upload the Play Data safety form from fastlane/metadata/android/data_safety.csv"
  desc "The CSV is the Play Console's own export format (Data safety > Export to CSV): edit it in a PR,"
  desc "never in the console, the same way as the listing copy. Runs with production releases."
  lane :upload_data_safety do
    require "googleauth"
    require "net/http"

    repo_root = File.expand_path("..")
    csv_path = File.join(repo_root, PLAY_DATA_SAFETY_CSV)
    UI.user_error!("#{PLAY_DATA_SAFETY_CSV} is missing") unless File.exist?(csv_path)

    credentials = Google::Auth::ServiceAccountCredentials.make_creds(
      json_key_io: File.open(ENV.fetch("PLAY_STORE_JSON_KEY_PATH")),
      scope: "https://www.googleapis.com/auth/androidpublisher",
    )
    access_token = credentials.fetch_access_token!.fetch("access_token")

    uri = URI("https://androidpublisher.googleapis.com/androidpublisher/v3/applications/#{ANDROID_PACKAGE}/dataSafety")
    request = Net::HTTP::Post.new(uri)
    request["Authorization"] = "Bearer #{access_token}"
    request["Content-Type"] = "application/json"
    request.body = JSON.generate(safetyLabels: File.read(csv_path))
    response = Net::HTTP.start(uri.host, uri.port, use_ssl: true) { |http| http.request(request) }

    unless response.is_a?(Net::HTTPSuccess)
      UI.user_error!("Play rejected the Data safety form (#{response.code}): #{response.body}")
    end
    UI.success("Data safety form uploaded")
  end
end

# ---------------------------------------------------------------------------
# iOS
# ---------------------------------------------------------------------------
platform :ios do
  desc "Build the signed release IPA (no upload) — see the `upload` lane"
  lane :build do
    # fastlane runs the lane from fastlane/; the repo root is its parent.
    repo_root = File.expand_path("..")

    # Creates an isolated temporary keychain on CI so signing never touches
    # the machine's login keychain. No-op when running outside CI.
    setup_ci

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_API_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY_P8"),
      is_key_content_base64: true,
      set_spaceship_token: true,
    )

    # Fetch the distribution certificate + provisioning profiles from the
    # private certs repo (configured in fastlane/Matchfile). readonly: the CI
    # never creates or revokes anything — that is done locally by an admin.
    match(
      type: "appstore",
      readonly: true,
      api_key: api_key,
    )

    # Switch the Release configuration to manual signing at build time only.
    # The committed project keeps automatic signing, so local development is
    # unaffected.
    update_code_signing_settings(
      use_automatic_signing: false,
      path: File.join(repo_root, XCODE_PROJECT),
      team_id: APPLE_TEAM_ID,
      targets: ["iosApp"],
      code_sign_identity: "Apple Distribution",
      profile_name: "match AppStore #{APP_BUNDLE_ID}",
      build_configurations: ["Release"],
    )
    update_code_signing_settings(
      use_automatic_signing: false,
      path: File.join(repo_root, XCODE_PROJECT),
      team_id: APPLE_TEAM_ID,
      targets: ["BibleDownloadWidgetExtension"],
      code_sign_identity: "Apple Distribution",
      profile_name: "match AppStore #{WIDGET_BUNDLE_ID}",
      build_configurations: ["Release"],
    )

    # The IPA is written to build/ios/ so the workflow can hand it to the
    # `upload` lane (a separate job), so a failed upload never costs a rebuild.
    # derived_data_path is pinned so the Crashlytics upload-symbols binary
    # (resolved by SPM under SourcePackages/) sits at a known path below.
    derived_data = File.join(repo_root, "build/derived_data")
    build_app(
      project: File.join(repo_root, XCODE_PROJECT),
      scheme: "iosApp",
      configuration: "Release",
      export_method: "app-store",
      output_directory: File.join(repo_root, "build/ios"),
      output_name: "BiblePlanner",
      derived_data_path: derived_data,
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          APP_BUNDLE_ID    => "match AppStore #{APP_BUNDLE_ID}",
          WIDGET_BUNDLE_ID => "match AppStore #{WIDGET_BUNDLE_ID}",
        },
      },
    )

    # Send dSYMs to Crashlytics explicitly. The Xcode "Upload Crashlytics dSYMs"
    # build phase also does this mid-archive, but over the network as a
    # best-effort step that fails silently on CI — leaving App Store builds
    # unsymbolicated (the "Missing dSYM" alerts). gym already collected every
    # dSYM (app + widget + the Kotlin `shared` framework) into one zip.
    #
    # Non-fatal, like the release-notes staging in the `submit` lane: a flaky
    # symbol upload must not fail the build or cost a rebuild. The persistent
    # "Missing dSYM" alert is the backstop — re-run scripts/upload_dsyms.sh by
    # hand if it ever slips through.
    begin
      upload_symbols = File.join(
        derived_data,
        "SourcePackages/checkouts/firebase-ios-sdk/Crashlytics/upload-symbols",
      )
      UI.user_error!("upload-symbols binary not found at #{upload_symbols}") unless File.exist?(upload_symbols)

      upload_symbols_to_crashlytics(
        dsym_path: File.join(repo_root, "build/ios/BiblePlanner.app.dSYM.zip"),
        gsp_path: File.join(repo_root, "iosApp/iosApp/GoogleService-Info.plist"),
        binary_path: upload_symbols,
      )
    rescue => e
      UI.error("Could not upload dSYMs to Crashlytics, continuing: #{e.message}")
    end
  end

  desc "Upload an already-built IPA (from the `build` lane) to App Store Connect — the binary only."
  desc "The listing and the review submission belong to the `submit` lane, so a failure there is"
  desc "retried without a second upload."
  lane :upload do
    # fastlane runs the lane from fastlane/; the repo root is its parent.
    repo_root = File.expand_path("..")

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_API_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY_P8"),
      is_key_content_base64: true,
      set_spaceship_token: true,
    )

    version, version_code = app_version(repo_root)
    if app_store_build_uploaded?(version, version_code)
      UI.important("Build #{version} (#{version_code}) is already on App Store Connect — skipping the upload.")
      next
    end

    upload_to_app_store(
      api_key: api_key,
      ipa: File.join(repo_root, "build/ios/BiblePlanner.ipa"),
      # The binary only: the listing, the screenshots and the submission have lanes of their own.
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: false,
      run_precheck_before_submit: false,
      # The App Store version belongs to the listing, and upload_screenshots may be creating it at
      # this very moment from another job. A binary needs no version to land in TestFlight.
      skip_app_version_update: true,
      force: true,
      precheck_include_in_app_purchases: false,
    )
  end

  desc "Update the App Store listing and submit the uploaded build (from the `upload` lane) for review."
  desc "Reads the version and the build number off the IPA, and waits for App Store Connect to"
  desc "finish processing that build before selecting it."
  lane :submit do
    # fastlane runs the lane from fastlane/; the repo root is its parent.
    repo_root = File.expand_path("..")

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_API_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY_P8"),
      is_key_content_base64: true,
      set_spaceship_token: true,
    )

    # Build the App Store "What's New" from the in-app release notes JSON.
    # Non-fatal: a failure here must not block shipping the build.
    has_release_notes = false
    begin
      has_release_notes = stage_release_notes(repo_root)
    rescue => e
      UI.error("Could not prepare release notes, continuing without them: #{e.message}")
    end

    # Submitting for review needs a valid "What's New". If the release notes
    # could not be staged, leave the build unsubmitted so the run does not
    # hard-fail — finish the submission from App Store Connect.
    submit_requested = ENV.fetch("SUBMIT_FOR_REVIEW", "true").strip.downcase == "true"
    submit = submit_requested && has_release_notes
    if submit_requested && !has_release_notes
      UI.important("No release notes staged — leaving the build without submitting it for review.")
    end

    # The `upload` lane already sent the binary, so the IPA restored into build/ios/ is only read
    # here: it names the version and the build to wait for and select. When SUBMIT_FOR_REVIEW is
    # true and notes are present, that build is submitted for Apple review and auto-released once
    # approved; otherwise it stays in App Store Connect / TestFlight.
    upload_to_app_store(
      api_key: api_key,
      ipa: File.join(repo_root, "build/ios/BiblePlanner.ipa"),
      skip_binary_upload: true,
      metadata_path: File.join(repo_root, "fastlane/metadata"),
      # Uploads the whole listing, not just the notes: name, subtitle, keywords and
      # description are versioned under fastlane/metadata/<locale>/ (see
      # docs/store-listing-metadata.md) and "What's New" is staged next to them above.
      # Edit the copy in a PR, never in App Store Connect — the next release overwrites it.
      # A locale with no staged notes still gets its listing copy; only that field is left
      # alone. When the notes cannot be staged at all, the listing is skipped with them,
      # which is the conservative half of an already non-fatal step.
      skip_metadata: !has_release_notes,
      skip_screenshots: true,
      submit_for_review: submit,
      automatic_release: submit,
      force: true,
      precheck_include_in_app_purchases: false,
    )
  end

  desc "Upload only the store listing screenshots to App Store Connect — no build, no submission."
  desc "Regenerates them first, so what is uploaded always matches the current app."
  desc "A live version's screenshots are read-only and a submitted one's are locked, so this runs"
  desc "before the release submits. APP_VERSION names the editable version, created if missing."
  desc "Options: skip_render (true|false) — upload what is already staged under"
  desc "fastlane/screenshots/, which is how CI hands over the images a job of its own rendered."
  lane :upload_screenshots do |options|
    repo_root = File.expand_path("..")
    screenshots_path = File.join(repo_root, "fastlane/screenshots")

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_API_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY_P8"),
      is_key_content_base64: true,
      set_spaceship_token: true,
    )

    # Renders every screen on the iOS simulator first, so this needs a Mac with Xcode.
    gradle(task: "stageAppStoreScreenshots", project_dir: repo_root) unless options[:skip_render]
    ensure_screenshots_staged(File.join(screenshots_path, "*", "*.png"))

    begin
      retrying_screenshot_set_race do
        upload_to_app_store(
          api_key: api_key,
          app_identifier: APP_BUNDLE_ID,
          # Names the version so deliver creates it when the screenshots arrive ahead of the binary;
          # unset, deliver falls back to the latest editable version.
          app_version: ENV["APP_VERSION"],
          screenshots_path: screenshots_path,
          # Listing assets only: no binary, no metadata, no review submission.
          skip_binary_upload: true,
          skip_metadata: true,
          skip_screenshots: false,
          submit_for_review: false,
          force: true,
          precheck_include_in_app_purchases: false,
          overwrite_screenshots: true,
        )
      end

      dedupe_app_store_screenshots
    ensure
      # deliver deletes every existing screenshot before re-uploading (overwrite_screenshots: true),
      # so a run that fails partway — like the "Screenshot Set Already Exists!" race once its
      # retries run out — can leave a locale with none at all. The workflow
      # hands this to the `submit` lane's job, which then skips submit_for_review instead of having
      # Apple reject the review submission outright with a bare "is not in valid state".
      report_app_store_screenshots_completeness(app_store_listing_locales)
    end
  end

  desc "Remove duplicate screenshots from the editable App Store version, keeping each shelf's first."
  desc "deliver re-uploads a screenshot when App Store Connect has not yet published its checksum,"
  desc "so an upload that in fact landed comes out twice; upload_screenshots runs this itself."
  lane :dedupe_screenshots do
    app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_API_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY_P8"),
      is_key_content_base64: true,
      set_spaceship_token: true,
    )
    dedupe_app_store_screenshots
  end
end

# Both stores replace the listing's screenshots with what is staged, so uploading from an empty
# folder — an artifact that did not download, a generator that rendered nothing — would wipe the
# listing instead of failing. Stops before anything reaches the store.
def ensure_screenshots_staged(glob)
  staged = Dir.glob(glob)
  UI.user_error!("No staged screenshots matching #{glob}") if staged.empty?
  UI.message("Found #{staged.size} staged screenshot(s)")
end

# Whether App Store Connect already holds this iOS build, in any processing state. It refuses a
# second upload of a build number it has taken ("The bundle version must be higher than the
# previously uploaded version"), so re-running the `upload` lane after the binary landed — 2.9.1's
# second attempt — has to skip the upload instead of dying on it. Never raises: when the lookup
# itself fails, the upload goes ahead as it always did.
def app_store_build_uploaded?(version, version_code)
  require "spaceship"
  app = Spaceship::ConnectAPI::App.find(APP_BUNDLE_ID)
  Spaceship::ConnectAPI::Build.all(
    app_id: app.id,
    version: version,
    build_number: version_code,
    # The macOS app shares this record and its build numbers.
    platform: Spaceship::ConnectAPI::Platform::IOS,
  ).any?
rescue => e
  UI.error("Could not look build #{version} (#{version_code}) up on App Store Connect, uploading: #{e.message}")
  false
end

# deliver deletes the version's screenshots and then recreates each locale's screenshot sets, but
# App Store Connect finishes deleting a set a little after it reports it gone. A set recreated too
# soon is refused with "Screenshot Set Already Exists!" (2.9.1 and 2.10.0 both lost their release
# submission to it) and deliver gives up on the whole upload. Waiting and running deliver again
# recovers: it deletes whatever the failed attempt uploaded and starts over on settled sets. Any
# other error, or the race outlasting every attempt, is raised as before.
def retrying_screenshot_set_race
  attempt = 1
  begin
    yield
  rescue => e
    raise unless e.message.include?(SCREENSHOT_SET_RACE_MESSAGE) && attempt < SCREENSHOT_SET_RACE_ATTEMPTS

    UI.important(
      "App Store Connect still holds a deleted screenshot set (attempt #{attempt} of " \
      "#{SCREENSHOT_SET_RACE_ATTEMPTS}), uploading again in #{SCREENSHOT_SET_RACE_WAIT_SECONDS}s",
    )
    sleep(SCREENSHOT_SET_RACE_WAIT_SECONDS)
    attempt += 1
    retry
  end
end

# App Store Connect publishes a screenshot's checksum asynchronously, and deliver's post-upload check
# reads that checksum to decide what landed. When it lags, deliver calls the screenshot missing and
# uploads it again — so a shelf ends up with the same file twice (2.9.0 shipped four such pairs, all
# in pt-BR). Screenshot order is the shelf order, so the later copy is the stray; dropping it keeps
# the listing exactly as staged. Idempotent: a clean version is a no-op.
def dedupe_app_store_screenshots
  app = Spaceship::ConnectAPI::App.find(APP_BUNDLE_ID)
  version = app.get_edit_app_store_version
  UI.user_error!("No editable App Store version to dedupe screenshots on") if version.nil?

  removed = 0
  version.get_app_store_version_localizations.each do |localization|
    localization.get_app_screenshot_sets.each do |set|
      seen = {}
      set.app_screenshots.each do |screenshot|
        if seen[screenshot.file_name]
          UI.important(
            "Removing duplicate #{localization.locale}/#{set.screenshot_display_type}/#{screenshot.file_name}",
          )
          screenshot.delete!
          removed += 1
        else
          seen[screenshot.file_name] = true
        end
      end
    end
  end

  if removed.zero?
    UI.success("No duplicate screenshots on App Store Connect")
  else
    UI.success("Removed #{removed} duplicate screenshot(s) from App Store Connect")
  end
end

# The locales among `locales` whose editable App Store version has no screenshot at all right now.
def locales_missing_app_store_screenshots(locales)
  app = Spaceship::ConnectAPI::App.find(APP_BUNDLE_ID)
  version = app.get_edit_app_store_version
  return locales if version.nil?

  present = version.get_app_store_version_localizations.select do |localization|
    localization.get_app_screenshot_sets.any? { |set| set.app_screenshots.any? }
  end.map(&:locale)

  locales - present
end

# Writes screenshots_complete=true/false to $GITHUB_OUTPUT (a no-op outside CI) for the workflow
# step that runs the `upload` lane to read, so it can skip submit_for_review when a locale ended
# up with no screenshots at all. Never raises: this is a diagnostic on top of upload_screenshots,
# not something that should mask whatever error the caller is already handling.
def report_app_store_screenshots_completeness(locales)
  incomplete = locales_missing_app_store_screenshots(locales)
  UI.error("No App Store screenshots for: #{incomplete.join(', ')}") if incomplete.any?

  output_path = ENV["GITHUB_OUTPUT"]
  return unless output_path

  File.open(output_path, "a") { |f| f.puts("screenshots_complete=#{incomplete.empty?}") }
rescue => e
  UI.error("Could not verify App Store screenshot completeness: #{e.message}")
end

# The jpackage runtime is a nested bundle with its own identifier, derived from the
# app bundle ID (verified in Contents/runtime/Contents/Info.plist of a `-Pmas` build).
MAC_RUNTIME_BUNDLE_ID = "com.oracle.java.#{APP_BUNDLE_ID}".freeze

desc "Create/fetch Mac App Store certificates and provisioning profiles into the certs repo. " \
     "Run locally by an admin; `produce` authenticates interactively with an Apple ID, and " \
     "`match` reuses the App Store Connect API key when the APP_STORE_CONNECT_API_KEY_* " \
     "variables are set."
lane :mac_certs do
  # Registers the App IDs on the developer portal if they don't exist yet. The
  # runtime bundle needs its own App ID so it can get a provisioning profile.
  # `produce` only supports Apple ID authentication, so it prompts on first run.
  [APP_BUNDLE_ID, MAC_RUNTIME_BUNDLE_ID].each do |identifier|
    produce(
      app_identifier: identifier,
      app_name: identifier == APP_BUNDLE_ID ? "Bible Planner" : "Bible Planner JVM Runtime",
      skip_itc: true,
      platform: "osx",
      team_id: APPLE_TEAM_ID,
    )
  end

  api_key = if ENV["APP_STORE_CONNECT_API_KEY_ID"]
    app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_API_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY_P8"),
      is_key_content_base64: true,
      set_spaceship_token: true,
    )
  end

  # Mac App Store distribution needs the application certificate (signs the .app) plus the
  # Mac Installer Distribution certificate (signs the uploaded .pkg). generate_apple_certs
  # is off so the app certificate is created as the classic "3rd Party Mac Developer
  # Application" kind — the Compose Gradle plugin (MacSigner, checked against 1.11.1) only
  # recognizes that prefix and "Developer ID Application", not the newer "Apple Distribution".
  match(
    type: "appstore",
    platform: "macos",
    additional_cert_types: ["mac_installer_distribution"],
    app_identifier: [APP_BUNDLE_ID, MAC_RUNTIME_BUNDLE_ID],
    api_key: api_key,
    readonly: false,
    generate_apple_certs: false,
    force_for_new_certificates: true,
  )
end
