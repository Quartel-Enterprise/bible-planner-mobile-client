fastlane/README.md
# The store listing copy under fastlane/metadata/ is authored and versioned — see
# docs/store-listing-metadata.md. Only what the pipeline generates into it is ignored:
# the "What's New" staged from the in-app release notes, and the Play screenshots and
# changelogs staged by `./gradlew stageStoreScreenshots` and the release lanes.
fastlane/metadata/*/release_notes.txt
fastlane/metadata/android/*/changelogs/
fastlane/metadata/android/*/images/
**/*.mobileprovision
**/*.provisionprofile
# `fastlane cert`/`sigh` drop these in the working directory. The .p12 holds the signing
# certificate's PRIVATE KEY — it belongs in the encrypted certs repo, never here.
**/*.p12
**/*.cer
**/*.certSigningRequest

# Supabase local secrets
supabase/.apple_client_secret
supabase/.temp/

# Generated store listing assets (./gradlew collectStoreScreenshots)
store_listings/
