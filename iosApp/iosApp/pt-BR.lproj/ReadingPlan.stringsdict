			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>Ver mais %ld semana</string>
			<key>other</key>
			<string>Ver mais %ld semanas</string>
		</dict>
	</dict>
	<key>no_read_for_days</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>Sem leitura há %ld dia</string>
			<key>other</key>
			<string>Sem leitura há %ld dias</string>
		</dict>
	</dict>
	<key>days_ahead_note</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
